*.mdf
*.ldf

# Variáveis de ambiente e segredos locais (API keys, tokens, senhas)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Configurações de ambiente .NET locais ou com segredos
appsettings.Production.json
appsettings.*.local.json
appsettings.secrets.json
secrets.json

# Certificados, chaves privadas e credenciais
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.pub
id_rsa
id_ed25519

